/*
 * Conformance Test: Create Logs Index
 *
 * This file defines the initial resource state for conformance testing.
 * The conformance test harness will apply this file first.
 */
amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@datadog/logs/index.pkl"
import "@datadog/datadog.pkl"

local stackName = "plugin-sdk-test-stack"
local testRunID = read("env:FORMAE_TEST_RUN_ID")

forma {
  new formae.Stack {
    label = stackName
    description = "Plugin SDK conformance test stack"
  }

  new formae.Target {
    label = "datadog-target"
    namespace = "DATADOG"
    // Keys are deliberately omitted here so this case covers the plugin
    // resolving them from DD_API_KEY and DD_APP_KEY at call time. The other
    // cases declare them in the target config and cover that path.
    config = new datadog.Config {
      site = read("env:DD_SITE")
    }
  }

  new index.Index {
    label = "plugin-sdk-test-index"
    name = "formae-plugin-sdk-test-\(testRunID)"

    filter = new index.IndexFilter {
      query = "source:test"
    }
  }
}
